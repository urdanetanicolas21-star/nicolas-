   ========================================================================== */
.animal-modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(2, 13, 7, 0.85);
  backdrop-filter: blur(10px);
  z-index: 1000;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
}

.animal-modal-overlay.active {
  display: flex;
}

.modal-content-card {
  background: linear-gradient(145deg, #062414, #0b3820);
