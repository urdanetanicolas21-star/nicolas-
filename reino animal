}

@keyframes modalPop {
  from { opacity: 0; transform: scale(0.92); }
  to { opacity: 1; transform: scale(1); }
}

.modal-close-btn {
  position: absolute;
  top: 1.25rem;
  right: 1.25rem;
  background: rgba(255, 255, 255, 0.1);
  border: none;
  color: var(--text-main);
  width: 36px;
  height: 36px;
  border-radius: 50%;
  cursor: pointer;
  font-size: 1.2rem;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: var(--transition-smooth);
}

.modal-close-btn:hover {
  background: var(--neon-lime);
  color: #04140b;
}

.modal-avatar {
  font-size: 3.5rem;
  margin-bottom: 0.75rem;
}

.modal-title {
  font-family: var(--font-heading);
  font-size: 1.8rem;
  color: #ffffff;
  margin-bottom: 0.25rem;
}

.modal-scientific {
