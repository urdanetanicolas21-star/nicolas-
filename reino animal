  color: var(--neon-lime);
  font-size: 0.9rem;
  margin-bottom: 1.25rem;
}

.modal-details-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0.75rem;
  margin-bottom: 1.5rem;
}

.modal-prop-box {
  background: rgba(0, 0, 0, 0.3);
  border: 1px solid var(--border-emerald);
  border-radius: 10px;
  padding: 0.75rem;
}

.modal-prop-lbl {
