        q === '' ||
        animal.name.toLowerCase().includes(q) ||
        animal.scientific.toLowerCase().includes(q) ||
        animal.groupLabel.toLowerCase().includes(q) ||
        animal.habitat.toLowerCase().includes(q);

      return matchesGroup && matchesSearch;
    });

    if (filtered.length === 0) {
      animalsGrid.innerHTML = `
        <div style="grid-column: 1 / -1; text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
          <div style="font-size: 3rem; margin-bottom: 0.5rem;">🔍🍃</div>
          <h3>No se encontraron animales con ese criterio</h3>
          <p>Prueba buscando con otro nombre como "León", "Mariposa", "Tiburón" o seleccionando otra categoría.</p>
        </div>
      `;
      return;
    }

    filtered.forEach((animal) => {
      const card = document.createElement('article');
      card.className = 'animal-card';
      card.innerHTML = `
        <div>
          <div class="card-top">
            <span class="animal-avatar">${animal.emoji}</span>
            <span class="group-badge ${animal.group}">${animal.groupLabel}</span>
          </div>
          <h3 class="animal-name">${animal.name}</h3>
          <div class="animal-scientific">${animal.scientific}</div>
          <div class="animal-props">
            <span class="prop-pill">🌿 ${animal.habitat.split(' ')[0]}</span>
            <span class="prop-pill">🥩 ${animal.diet.split(' ')[0]}</span>
          </div>
          <p class="animal-fact">${animal.summary}</p>
        </div>
        <button class="btn-card-detail" data-id="${animal.id}">
          Ver Ficha Completa →
        </button>
      `;

      const detailBtn = card.querySelector('.btn-card-detail');
      detailBtn.addEventListener('click', () => {
        openAnimalModal(animal);
      });

      animalsGrid.appendChild(card);
    });
  }

  // Eventos de filtro
  filterChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      filterChips.forEach((c) => c.classList.remove('active'));
      chip.classList.add('active');
      currentGroupFilter = chip.dataset.filter;
      playSoftClick();
      renderAnimals();
    });
  });

  // Evento de búsqueda
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      currentSearchQuery = e.target.value;
      renderAnimals();
    });
  }

  renderAnimals();

  // --------------------------------------------------------------------------
  // 4. MODAL DE FICHA ZOOLOGICA
  // --------------------------------------------------------------------------
  const modalOverlay = document.getElementById('animalModalOverlay');
  const modalCloseBtn = document.getElementById('modalCloseBtn');
  const modalAvatar = document.getElementById('modalAvatar');
  const modalTitle = document.getElementById('modalTitle');
  const modalScientific = document.getElementById('modalScientific');
  const modalHabitat = document.getElementById('modalHabitat');
  const modalDiet = document.getElementById('modalDiet');
  const modalSize = document.getElementById('modalSize');
  const modalConservation = document.getElementById('modalConservation');
  const modalBio = document.getElementById('modalBio');
  const modalSuperpower = document.getElementById('modalSuperpower');

  function openAnimalModal(animal) {
    if (!modalOverlay) return;

    modalAvatar.textContent = animal.emoji;
    modalTitle.textContent = animal.name;
    modalScientific.textContent = `${animal.scientific} • ${animal.groupLabel}`;
    modalHabitat.textContent = animal.habitat;
    modalDiet.textContent = animal.diet;
    modalSize.textContent = animal.size;
    modalConservation.textContent = animal.conservation;
    modalBio.textContent = animal.summary;
    modalSuperpower.textContent = `⚡ Adaptación Asombrosa: ${animal.superpower} (Longevidad: ${animal.lifespan})`;

    modalOverlay.classList.add('active');
    playSoftClick();
  }

  function closeModal() {
    if (modalOverlay) {
      modalOverlay.classList.remove('active');
    }
  }

  if (modalCloseBtn) {
    modalCloseBtn.addEventListener('click', closeModal);
  }

  if (modalOverlay) {
    modalOverlay.addEventListener('click', (e) => {
      if (e.target === modalOverlay) {
        closeModal();
      }
    });
  }

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modalOverlay && modalOverlay.classList.contains('active')) {
      closeModal();
    }
  });

  // --------------------------------------------------------------------------
  // 5. TRIVIA DEL REINO ANIMAL
  // --------------------------------------------------------------------------
  const quizData = [
    {
      question: '¿Cuál de los siguientes animales es un mamífero pero pone huevos en lugar de parir crías vivas?',
      options: ['El Delfín Rosado', 'El Ornitorrinco', 'El Murciélago', 'El Canguro'],
      correct: 1,
      explanation: 'El ornitorrinco y los equidnas son los únicos mamíferos monotremas del planeta que ponen huevos, pero amamantan a sus crías recién nacidas con leche.'
    },
    {
      question: '¿Cuántas patas tiene estrictamente cualquier insecto adulto en su anatomía?',
      options: ['6 patas (3 pares)', '8 patas (4 pares)', '10 patas', 'Varía entre 6 y 14 según el clima'],
      correct: 0,
      explanation: 'Todos los insectos pertenecen a los hexápodos y poseen exactamente 6 patas articuladas divididas en tres segmentos torácicos. Las arañas tienen 8 y son arácnidos, no insectos.'
    },
    {
      question: '¿Qué porcentaje aproximado de todas las especies animales conocidas en la Tierra son invertebrados?',
      options: ['Aproximadamente el 20%', 'Alrededor del 50%', 'Más del 95%', 'Solo el 5%'],
      correct: 2,
      explanation: '¡Los invertebrados dominan la Tierra! Más del 95% de todas las especies descritas por la ciencia carecen de columna vertebral, siendo los artrópodos (insectos, arácnidos, crustáceos) los más abundantes.'
    },
    {
      question: '¿Cuál es el único mamífero del reino animal dotado con la capacidad de vuelo verdadero y sustentado?',
      options: ['La Ardilla Voladora', 'El Murciélago', 'El Lémur Volador', 'El Colibrí'],
      correct: 1,
      explanation: 'Las ardillas y lémures solo planean, mientras que los murciélagos poseen alas membranosas verdaderas con huesos homólogos a dedos humanos capaces de aletear y maniobrar en el aire.'
    }
  ];

  let currentQuestionIndex = 0;
  let quizScore = 0;

  const quizQuestionText = document.getElementById('quizQuestionText');
  const quizOptionsGrid = document.getElementById('quizOptionsGrid');
  const quizFeedback = document.getElementById('quizFeedback');
  const quizScoreEl = document.getElementById('quizScoreEl');
  const quizNextBtn = document.getElementById('quizNextBtn');

  function renderQuestion() {
    const q = quizData[currentQuestionIndex];
    if (!q) return;

    if (quizQuestionText) quizQuestionText.textContent = `${currentQuestionIndex + 1}. ${q.question}`;
    if (quizFeedback) {
      quizFeedback.style.display = 'none';
      quizFeedback.textContent = '';
    }
    if (quizNextBtn) quizNextBtn.style.display = 'none';

    if (quizOptionsGrid) {
      quizOptionsGrid.innerHTML = '';
      q.options.forEach((opt, idx) => {
        const btn = document.createElement('button');
        btn.className = 'option-btn';
        btn.textContent = opt;
        btn.addEventListener('click', () => handleOptionSelect(idx, btn));
        quizOptionsGrid.appendChild(btn);
      });
    }

    if (quizScoreEl) {
      quizScoreEl.textContent = `Puntaje: ${quizScore} / ${quizData.length}`;
    }
  }

  function handleOptionSelect(selectedIndex, clickedBtn) {
    const q = quizData[currentQuestionIndex];
    const allBtns = quizOptionsGrid.querySelectorAll('.option-btn');
    allBtns.forEach((b) => (b.disabled = true));

    if (selectedIndex === q.correct) {
      clickedBtn.classList.add('correct');
      quizScore++;
      playSuccessChime();
      quizFeedback.innerHTML = `<strong>¡Exacto! 🌿🎉</strong> ${q.explanation}`;
    } else {
      clickedBtn.classList.add('incorrect');
      allBtns[q.correct].classList.add('correct');
      playSoftClick();
      quizFeedback.innerHTML = `<strong>Incorrecto.</strong> ${q.explanation}`;
    }

    quizFeedback.style.display = 'block';
    if (quizScoreEl) quizScoreEl.textContent = `Puntaje: ${quizScore} / ${quizData.length}`;

    if (currentQuestionIndex < quizData.length - 1) {
      if (quizNextBtn) {
        quizNextBtn.style.display = 'inline-flex';
        quizNextBtn.textContent = 'Siguiente Pregunta →';
      }
    } else {
      if (quizNextBtn) {
        quizNextBtn.style.display = 'inline-flex';
        quizNextBtn.textContent = 'Ver Resultado Final 🏆';
      }
    }
  }

  if (quizNextBtn) {
    quizNextBtn.addEventListener('click', () => {
      if (currentQuestionIndex < quizData.length - 1) {
        currentQuestionIndex++;
        renderQuestion();
      } else {
        if (quizQuestionText) {
          quizQuestionText.textContent = `¡Trivia Finalizada! Obtuviste ${quizScore} de ${quizData.length} aciertos.`;
        }
        if (quizOptionsGrid) quizOptionsGrid.innerHTML = '';
        quizFeedback.style.display = 'block';
        quizFeedback.innerHTML = `
          <div style="text-align: center; padding: 1.5rem 0;">
            <h3>${quizScore >= 3 ? '🐾 ¡Sos un Zoólogo Experto del Reino Animal!' : '🌱 ¡Buen trabajo! Ahora conoces mucho mejor la asombrosa diversidad de la fauna.'}</h3>
            <p style="margin-top: 0.5rem; color: var(--text-muted);">Sigue explorando las fichas y asómbrate con las criaturas que comparten nuestro planeta.</p>
          </div>
        `;
        quizNextBtn.style.display = 'none';
        playSuccessChime();
      }
    });
  }

  renderQuestion();
});
