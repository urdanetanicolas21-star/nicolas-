   ========================================================================== */
.trivia-container {
  background: var(--bg-jungle-card);
  border: 1px solid var(--border-glow);
  border-radius: 24px;
  padding: 2.5rem;
  max-width: 820px;
  margin: 0 auto;
  backdrop-filter: blur(16px);
}

.trivia-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
  border-bottom: 1px solid var(--border-emerald);
  padding-bottom: 1rem;
}

.question-text {
  font-family: var(--font-heading);
  font-size: 1.35rem;
  font-weight: 700;
  margin-bottom: 1.5rem;
  color: #ffffff;
}

.options-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0.85rem;
  margin-bottom: 1.5rem;
}

.option-btn {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--border-emerald);
  color: var(--text-main);
  padding: 1rem 1.25rem;
  border-radius: 12px;
  text-align: left;
  font-size: 0.95rem;
  cursor: pointer;
  transition: var(--transition-smooth);
}

.option-btn:hover {
  background: rgba(0, 255, 135, 0.12);
  border-color: var(--neon-lime);
}

.option-btn.correct {
  background: rgba(16, 185, 129, 0.25);
  border-color: var(--neon-lime);
  color: #a7f3d0;
}

.option-btn.incorrect {
  background: rgba(251, 113, 133, 0.25);
  border-color: var(--tropical-coral);
  color: #fecdd3;
}

.quiz-feedback {
  background: rgba(0, 0, 0, 0.3);
  border-radius: 10px;
  padding: 1rem;
  font-size: 0.9rem;
  display: none;
  margin-bottom: 1.25rem;
  border-left: 3px solid var(--neon-lime);
}

/* ==========================================================================
