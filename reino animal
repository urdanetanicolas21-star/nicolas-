/* ==========================================================================
   REINO ANIMAL - ESTILOS PRINCIPALES
   Estética de Selva Esmeralda, Fondo Verde Vibrante, Glassmorphism y Biodiversidad
   ========================================================================== */

@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');

:root {
  /* Paleta Verde Selva y Esmeralda */
  --bg-deep-forest: #04140b;
  --bg-jungle-dark: #072213;
  --bg-jungle-card: rgba(8, 38, 22, 0.75);
  --bg-jungle-card-hover: rgba(14, 54, 32, 0.9);
  
  --emerald-vibrant: #10b981;
  --neon-lime: #00ff87;
  --leaf-light: #4ade80;
  --moss-accent: #a3e635;
  --jungle-gold: #facc15;
  --tropical-coral: #fb7185;
  --cyan-aquatic: #38bdf8;

  --text-main: #f0fdf4;
  --text-muted: #86efac;
  --text-dim: #4ade80b3;
  
  --border-emerald: rgba(16, 185, 129, 0.25);
  --border-glow: rgba(0, 255, 135, 0.5);
  --glow-lime: 0 0 25px rgba(0, 255, 135, 0.4);
  --card-shadow: 0 16px 36px -10px rgba(0, 0, 0, 0.7);

  --font-heading: 'Outfit', sans-serif;
  --font-body: 'Plus Jakarta Sans', sans-serif;
  --transition-smooth: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

/* Reset y base */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  font-size: 16px;
}

body {
  font-family: var(--font-body);
  background-color: var(--bg-deep-forest);
  color: var(--text-main);
  line-height: 1.6;
  overflow-x: hidden;
  min-height: 100vh;
  position: relative;
}

/* Fondo verde envolvente con gradientes orgánicos de jungla */
.jungle-ambient-bg {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  background: 
    radial-gradient(circle at 10% 20%, rgba(0, 255, 135, 0.12) 0%, transparent 45%),
    radial-gradient(circle at 90% 70%, rgba(16, 185, 129, 0.15) 0%, transparent 55%),
    radial-gradient(circle at 50% 90%, rgba(163, 230, 53, 0.08) 0%, transparent 50%),
    linear-gradient(180deg, #020d07 0%, #062013 50%, #03140c 100%);
}

/* ==========================================================================
   BARRA SUPERIOR (SELVA ALIVE TICKER)
   ========================================================================== */
.top-notice-bar {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(4, 20, 11, 0.88);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--border-emerald);
  padding: 0.6rem 1.5rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.85rem;
}

.notice-badge {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  color: var(--neon-lime);
  font-weight: 700;
}

.leaf-pulse {
  display: inline-block;
  animation: leafFloat 2.5s infinite ease-in-out;
}

@keyframes leafFloat {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-3px) rotate(8deg); }
}

.top-bar-actions {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.btn-nature-sound {
  background: rgba(0, 255, 135, 0.12);
  border: 1px solid rgba(0, 255, 135, 0.3);
  color: var(--neon-lime);
  padding: 0.35rem 0.9rem;
  border-radius: 20px;
  font-size: 0.82rem;
  font-weight: 700;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  transition: var(--transition-smooth);
}

.btn-nature-sound:hover {
  background: rgba(0, 255, 135, 0.25);
  box-shadow: 0 0 15px rgba(0, 255, 135, 0.35);
}

.btn-nature-sound.playing {
  background: rgba(163, 230, 53, 0.25);
  border-color: var(--moss-accent);
  color: #bef264;
}

/* ==========================================================================
   HEADER Y NAVEGACIÓN
   ========================================================================== */
.main-header {
  position: relative;
  z-index: 10;
  max-width: 1280px;
  margin: 0 auto;
  padding: 1.25rem 1.5rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 0.85rem;
  text-decoration: none;
  color: var(--text-main);
}

.brand-icon-box {
  width: 46px;
  height: 46px;
  border-radius: 14px;
  background: linear-gradient(135deg, rgba(0, 255, 135, 0.25), rgba(16, 185, 129, 0.5));
  border: 1px solid var(--border-glow);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.6rem;
  box-shadow: 0 0 16px rgba(0, 255, 135, 0.3);
}

.brand-text h1 {
  font-family: var(--font-heading);
  font-size: 1.4rem;
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -0.5px;
}

.brand-text span {
  font-size: 0.75rem;
  color: var(--neon-lime);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1.2px;
}

.main-nav ul {
  display: flex;
  list-style: none;
  gap: 1.5rem;
}

.main-nav a {
  text-decoration: none;
  color: var(--text-muted);
  font-weight: 600;
  font-size: 0.92rem;
  transition: var(--transition-smooth);
  position: relative;
}

.main-nav a:hover,
.main-nav a:focus {
  color: var(--neon-lime);
}

.main-nav a::after {
  content: '';
  position: absolute;
  bottom: -4px;
  left: 0;
  width: 0%;
  height: 2px;
  background: var(--neon-lime);
  box-shadow: 0 0 8px var(--neon-lime);
  transition: var(--transition-smooth);
}

.main-nav a:hover::after {
  width: 100%;
}

/* ==========================================================================
   HERO SECTION
   ========================================================================== */
.hero {
  position: relative;
  z-index: 10;
  max-width: 1280px;
  margin: 1.5rem auto 4.5rem;
  padding: 0 1.5rem;
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 3rem;
  align-items: center;
}

.hero-tag {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.35rem 0.9rem;
  border-radius: 30px;
  background: rgba(0, 255, 135, 0.12);
  border: 1px solid var(--border-glow);
  color: var(--neon-lime);
  font-size: 0.82rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.8px;
  margin-bottom: 1.25rem;
}

.hero-title {
  font-family: var(--font-heading);
  font-size: 3.5rem;
  line-height: 1.08;
  font-weight: 900;
  letter-spacing: -1.5px;
  margin-bottom: 1.25rem;
}

.hero-title .highlight-lime {
  color: var(--neon-lime);
  text-shadow: var(--glow-lime);
  display: inline-block;
}

.hero-title .highlight-gold {
  color: var(--jungle-gold);
}

.hero-desc {
  font-size: 1.15rem;
  color: var(--text-muted);
  margin-bottom: 2rem;
  max-width: 580px;
  line-height: 1.65;
}

.hero-stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
  margin-bottom: 2rem;
}

.stat-card {
  background: var(--bg-jungle-card);
  border: 1px solid var(--border-emerald);
  border-radius: 16px;
  padding: 1.15rem 1rem;
  backdrop-filter: blur(12px);
  transition: var(--transition-smooth);
}

.stat-card:hover {
  transform: translateY(-3px);
  border-color: var(--neon-lime);
  box-shadow: 0 8px 25px rgba(0, 255, 135, 0.18);
}

.stat-num {
  font-family: var(--font-heading);
  font-size: 1.9rem;
  font-weight: 800;
  color: var(--neon-lime);
  line-height: 1.1;
  margin-bottom: 0.25rem;
}

.stat-label {
  font-size: 0.78rem;
  color: var(--text-muted);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.6rem;
  padding: 0.85rem 1.6rem;
  border-radius: 12px;
  font-weight: 700;
  font-size: 0.95rem;
  cursor: pointer;
  text-decoration: none;
  transition: var(--transition-smooth);
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, var(--neon-lime), #059669);
  color: #03140c;
  box-shadow: 0 4px 20px rgba(0, 255, 135, 0.35);
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 28px rgba(0, 255, 135, 0.55);
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.05);
  color: var(--text-main);
  border: 1px solid var(--border-emerald);
  backdrop-filter: blur(8px);
}

.btn-secondary:hover {
  background: rgba(0, 255, 135, 0.12);
  border-color: var(--neon-lime);
  color: var(--neon-lime);
}

.hero-image-card {
  position: relative;
  border-radius: 24px;
  overflow: hidden;
  border: 1px solid var(--border-glow);
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.65);
}

.hero-image-card img {
  width: 100%;
  height: 440px;
  object-fit: cover;
  display: block;
  transition: transform 0.6s ease;
}

.hero-image-card:hover img {
  transform: scale(1.03);
}

.hero-image-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(4, 20, 11, 0.92) 0%, rgba(4, 20, 11, 0.2) 50%, transparent 100%);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 1.75rem;
}

.overlay-badge {
  font-size: 0.8rem;
  font-weight: 800;
  color: var(--neon-lime);
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 0.25rem;
}

.overlay-caption {
  font-size: 1.15rem;
  font-weight: 700;
  color: #ffffff;
}

/* ==========================================================================
   SECCIONES GENERALES
   ========================================================================== */
.section {
  position: relative;
  z-index: 10;
  max-width: 1280px;
  margin: 0 auto 5rem;
  padding: 0 1.5rem;
}

.section-header {
  text-align: center;
  margin-bottom: 3rem;
  max-width: 760px;
  margin-left: auto;
  margin-right: auto;
}

.section-tag {
  font-size: 0.85rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: var(--neon-lime);
  margin-bottom: 0.5rem;
  display: block;
}

.section-title {
  font-family: var(--font-heading);
  font-size: 2.4rem;
  font-weight: 800;
  letter-spacing: -1px;
  margin-bottom: 0.75rem;
}

.section-desc {
  font-size: 1.05rem;
  color: var(--text-muted);
}

/* ==========================================================================
   EL GRAN ÁRBOL TAXONÓMICO: VERTEBRADOS VS INVERTEBRADOS
   ========================================================================== */
.taxo-comparison-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  margin-bottom: 2rem;
}

.taxo-box {
  background: var(--bg-jungle-card);
  border: 1px solid var(--border-emerald);
  border-radius: 20px;
  padding: 2rem;
  backdrop-filter: blur(16px);
  position: relative;
  overflow: hidden;
  transition: var(--transition-smooth);
}

.taxo-box:hover {
  border-color: var(--neon-lime);
  box-shadow: 0 10px 30px rgba(0, 255, 135, 0.15);
}

.taxo-box.vertebrados::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 4px;
  background: linear-gradient(90deg, var(--neon-lime), var(--moss-accent));
}

.taxo-box.invertebrados::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 4px;
  background: linear-gradient(90deg, var(--jungle-gold), var(--tropical-coral));
}

.taxo-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.25rem;
}

.taxo-header h3 {
  font-family: var(--font-heading);
  font-size: 1.6rem;
  font-weight: 800;
}

.taxo-share-badge {
  background: rgba(0, 255, 135, 0.15);
  color: var(--neon-lime);
  border: 1px solid rgba(0, 255, 135, 0.3);
  padding: 0.25rem 0.75rem;
  border-radius: 20px;
  font-size: 0.8rem;
  font-weight: 800;
}

.taxo-intro {
  color: var(--text-muted);
  font-size: 0.92rem;
  margin-bottom: 1.5rem;
  line-height: 1.6;
}

.taxo-subclasses-list {
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
}

.taxo-class-item {
  background: rgba(0, 0, 0, 0.25);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 12px;
  padding: 0.85rem 1rem;
  display: flex;
  align-items: center;
  gap: 0.85rem;
  transition: var(--transition-smooth);
}

.taxo-class-item:hover {
  background: rgba(0, 255, 135, 0.08);
  border-color: rgba(0, 255, 135, 0.25);
  transform: translateX(4px);
}

.class-emoji {
  font-size: 1.6rem;
  flex-shrink: 0;
}

.class-info h4 {
  font-size: 1rem;
  color: #ffffff;
  margin-bottom: 0.15rem;
}

.class-info p {
  font-size: 0.8rem;
  color: var(--text-muted);
}

/* ==========================================================================
   ENCICLOPEDIA INTERACTIVA CON FILTROS Y BUSCADOR
   ========================================================================== */
.encyclo-controls {
  background: var(--bg-jungle-card);
  border: 1px solid var(--border-emerald);
  border-radius: 20px;
  padding: 1.5rem;
  margin-bottom: 2.5rem;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  backdrop-filter: blur(12px);
}

.search-box-wrap {
  position: relative;
}

.search-input {
  width: 100%;
  padding: 0.9rem 1.25rem 0.9rem 3rem;
  background: rgba(4, 20, 11, 0.85);
  border: 1px solid var(--border-emerald);
  border-radius: 12px;
  color: var(--text-main);
  font-family: var(--font-body);
  font-size: 0.95rem;
  outline: none;
  transition: var(--transition-smooth);
}

.search-input:focus {
  border-color: var(--neon-lime);
  box-shadow: 0 0 16px rgba(0, 255, 135, 0.3);
}

.search-icon {
  position: absolute;
  top: 50%;
  left: 1rem;
  transform: translateY(-50%);
  font-size: 1.2rem;
  color: var(--text-muted);
  pointer-events: none;
}

.filter-chips-row {
  display: flex;
  gap: 0.6rem;
  flex-wrap: wrap;
}

.filter-chip {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--border-emerald);
  color: var(--text-muted);
  padding: 0.5rem 1.1rem;
  border-radius: 20px;
  font-size: 0.85rem;
  font-weight: 700;
  cursor: pointer;
  transition: var(--transition-smooth);
}

.filter-chip.active,
.filter-chip:hover {
  background: rgba(0, 255, 135, 0.2);
  border-color: var(--neon-lime);
  color: var(--neon-lime);
}

/* Cuadrícula de Tarjetas de Animales */
.animals-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
  gap: 1.5rem;
}

.animal-card {
  background: var(--bg-jungle-card);
  border: 1px solid var(--border-emerald);
  border-radius: 18px;
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  backdrop-filter: blur(14px);
  transition: var(--transition-smooth);
  position: relative;
  overflow: hidden;
}

.animal-card:hover {
  transform: translateY(-5px);
  border-color: var(--neon-lime);
  box-shadow: 0 14px 35px rgba(0, 0, 0, 0.7);
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 1rem;
}

.animal-avatar {
  font-size: 2.6rem;
  line-height: 1;
  filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.4));
}

.group-badge {
  font-size: 0.72rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.6px;
  padding: 0.25rem 0.65rem;
  border-radius: 20px;
}

.group-badge.mamifero {
  background: rgba(250, 204, 21, 0.15);
  color: var(--jungle-gold);
  border: 1px solid rgba(250, 204, 21, 0.3);
}

.group-badge.insecto {
  background: rgba(0, 255, 135, 0.15);
  color: var(--neon-lime);
  border: 1px solid rgba(0, 255, 135, 0.3);
}

.group-badge.ave {
  background: rgba(56, 189, 248, 0.15);
  color: var(--cyan-aquatic);
  border: 1px solid rgba(56, 189, 248, 0.3);
}

.group-badge.reptil {
  background: rgba(163, 230, 53, 0.15);
  color: var(--moss-accent);
  border: 1px solid rgba(163, 230, 53, 0.3);
}

.group-badge.anfibio {
  background: rgba(52, 211, 153, 0.15);
  color: #34d399;
  border: 1px solid rgba(52, 211, 153, 0.3);
}

.group-badge.marino {
  background: rgba(14, 165, 233, 0.15);
  color: #38bdf8;
  border: 1px solid rgba(14, 165, 233, 0.3);
}

.animal-name {
  font-family: var(--font-heading);
  font-size: 1.35rem;
  font-weight: 800;
  margin-bottom: 0.2rem;
  color: #ffffff;
}

.animal-scientific {
  font-size: 0.8rem;
  font-style: italic;
  color: var(--text-muted);
  margin-bottom: 0.85rem;
}

.animal-props {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin-bottom: 1rem;
}

.prop-pill {
  background: rgba(0, 0, 0, 0.3);
  padding: 0.2rem 0.55rem;
  border-radius: 6px;
  font-size: 0.75rem;
  color: var(--text-main);
  border: 1px solid rgba(255, 255, 255, 0.06);
}

.animal-fact {
  font-size: 0.86rem;
  color: var(--text-muted);
  line-height: 1.5;
  margin-bottom: 1.25rem;
}

.btn-card-detail {
  background: rgba(0, 255, 135, 0.12);
  border: 1px solid var(--border-emerald);
  color: var(--neon-lime);
  width: 100%;
  padding: 0.65rem 0.75rem;
  border-radius: 10px;
  font-weight: 700;
  font-size: 0.85rem;
  cursor: pointer;
  transition: var(--transition-smooth);
}

.btn-card-detail:hover {
  background: var(--neon-lime);
  color: #03140c;
  box-shadow: 0 0 15px rgba(0, 255, 135, 0.4);
}

/* ==========================================================================
   SECCIÓN INSECTOS: EL MICRO REINO
   ========================================================================== */
.insects-spotlight-card {
  background: var(--bg-jungle-card);
  border: 1px solid var(--border-glow);
  border-radius: 24px;
  overflow: hidden;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  backdrop-filter: blur(16px);
}

.insect-image-box img {
  width: 100%;
  height: 100%;
  min-height: 480px;
  object-fit: cover;
  display: block;
}

.insect-text-box {
  padding: 3.5rem;
}

.insect-text-box h3 {
  font-family: var(--font-heading);
  font-size: 2.2rem;
  font-weight: 900;
  line-height: 1.15;
  margin-bottom: 1rem;
}

.insect-text-box p {
  color: var(--text-muted);
  font-size: 0.95rem;
  line-height: 1.65;
  margin-bottom: 1.5rem;
}

.insect-orders-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem;
}

.order-mini-card {
  background: rgba(0, 0, 0, 0.3);
  border: 1px solid var(--border-emerald);
  border-radius: 12px;
  padding: 1rem;
}

.order-mini-card h4 {
  font-size: 0.95rem;
  color: var(--neon-lime);
  margin-bottom: 0.25rem;
}

.order-mini-card span {
  font-size: 0.78rem;
  color: var(--text-muted);
}

/* ==========================================================================
   SALA DE RÉCORDS ANIMALES
   ========================================================================== */
.records-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.5rem;
}

.record-card {
  background: var(--bg-jungle-card);
  border: 1px solid var(--border-emerald);
  border-radius: 18px;
  padding: 1.75rem;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition: var(--transition-smooth);
}

.record-card:hover {
  transform: translateY(-4px);
  border-color: var(--neon-lime);
  box-shadow: var(--card-shadow);
}

.record-icon {
  font-size: 2.2rem;
  margin-bottom: 0.75rem;
  display: inline-block;
}

.record-category {
  font-size: 0.75rem;
  font-weight: 800;
  color: var(--jungle-gold);
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 0.35rem;
}

.record-holder {
  font-family: var(--font-heading);
  font-size: 1.35rem;
  font-weight: 800;
  margin-bottom: 0.4rem;
