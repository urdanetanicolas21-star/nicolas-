/* ==========================================================================
   USO DEL AGUA - ESTILOS PRINCIPALES
   Estética acuática de vanguardia, glassmorphism, animaciones y fluidez
   ========================================================================== */

@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@400;600;700;800;900&display=swap');

:root {
  /* Paleta Acuática y Fresca */
  --bg-deep: #030b15;
  --bg-marine: #071626;
  --bg-card: rgba(10, 28, 48, 0.7);
  --bg-card-hover: rgba(16, 42, 71, 0.85);
  
  --primary-cyan: #00d2ff;
  --primary-blue: #0077b6;
  --aqua-glow: #38bdf8;
  --emerald-fresh: #10b981;
  --emerald-glow: rgba(16, 185, 129, 0.35);
  --warning-amber: #f59e0b;
  --danger-coral: #f43f5e;
  
  --text-primary: #f8fafc;
  --text-secondary: #94a3b8;
  --text-muted: #64748b;
  
  --border-glass: rgba(56, 189, 248, 0.2);
  --border-focus: rgba(0, 210, 255, 0.6);
  --card-shadow: 0 16px 36px -10px rgba(0, 0, 0, 0.6);
  --glow-cyan: 0 0 25px rgba(0, 210, 255, 0.4);
  
  --font-heading: 'Outfit', sans-serif;
  --font-body: 'Plus Jakarta Sans', sans-serif;
  --transition-smooth: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

/* Reset y base */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  font-size: 16px;
}

body {
  font-family: var(--font-body);
  background-color: var(--bg-deep);
  color: var(--text-primary);
  line-height: 1.6;
  overflow-x: hidden;
  min-height: 100vh;
  position: relative;
}

/* Fondo dinámico con partículas sutiles de agua */
.ambient-water-bg {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  background: 
    radial-gradient(circle at 15% 25%, rgba(0, 210, 255, 0.08) 0%, transparent 45%),
    radial-gradient(circle at 85% 75%, rgba(16, 185, 129, 0.06) 0%, transparent 50%),
    radial-gradient(circle at 50% 50%, rgba(0, 119, 182, 0.07) 0%, transparent 60%);
}

/* ==========================================================================
   BARRA SUPERIOR DE ALERTA Y RECURSOS
   ========================================================================== */
.top-notice-bar {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(3, 11, 21, 0.88);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--border-glass);
  padding: 0.6rem 1.5rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.85rem;
}

.notice-badge {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  color: var(--primary-cyan);
  font-weight: 600;
}

.droplet-pulse {
  display: inline-block;
  animation: floatDrop 2s infinite ease-in-out;
}

@keyframes floatDrop {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-3px); }
}

.top-bar-actions {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.btn-ambient-sound {
  background: rgba(0, 210, 255, 0.1);
  border: 1px solid rgba(0, 210, 255, 0.25);
  color: var(--primary-cyan);
  padding: 0.35rem 0.85rem;
  border-radius: 20px;
  font-size: 0.8rem;
  font-weight: 600;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  transition: var(--transition-smooth);
}

.btn-ambient-sound:hover {
  background: rgba(0, 210, 255, 0.2);
  box-shadow: 0 0 12px rgba(0, 210, 255, 0.3);
}

.btn-ambient-sound.playing {
  background: rgba(16, 185, 129, 0.2);
  border-color: var(--emerald-fresh);
  color: #34d399;
}

/* ==========================================================================
   HEADER Y NAVEGACIÓN
   ========================================================================== */
.main-header {
  position: relative;
  z-index: 10;
  max-width: 1280px;
  margin: 0 auto;
  padding: 1.25rem 1.5rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 0.85rem;
  text-decoration: none;
  color: var(--text-primary);
}

.brand-icon-box {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: linear-gradient(135deg, rgba(0, 210, 255, 0.25), rgba(0, 119, 182, 0.4));
  border: 1px solid var(--border-glass);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5rem;
  box-shadow: 0 0 15px rgba(0, 210, 255, 0.25);
}

.brand-text h1 {
  font-family: var(--font-heading);
  font-size: 1.35rem;
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -0.5px;
}

.brand-text span {
  font-size: 0.75rem;
  color: var(--primary-cyan);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.main-nav ul {
  display: flex;
  list-style: none;
  gap: 1.5rem;
}

.main-nav a {
  text-decoration: none;
  color: var(--text-secondary);
  font-weight: 600;
  font-size: 0.92rem;
  transition: var(--transition-smooth);
  position: relative;
}

.main-nav a:hover,
.main-nav a:focus {
  color: var(--primary-cyan);
}

.main-nav a::after {
  content: '';
  position: absolute;
  bottom: -4px;
  left: 0;
  width: 0%;
  height: 2px;
  background: var(--primary-cyan);
  box-shadow: 0 0 8px var(--primary-cyan);
  transition: var(--transition-smooth);
}

.main-nav a:hover::after {
  width: 100%;
}

/* ==========================================================================
   HERO SECTION
   ========================================================================== */
.hero {
  position: relative;
  z-index: 10;
  max-width: 1280px;
  margin: 1.5rem auto 4.5rem;
  padding: 0 1.5rem;
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 3rem;
  align-items: center;
}

.hero-tag {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.35rem 0.9rem;
  border-radius: 30px;
  background: rgba(0, 210, 255, 0.1);
  border: 1px solid var(--border-glass);
  color: var(--primary-cyan);
  font-size: 0.82rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.8px;
  margin-bottom: 1.25rem;
}

.hero-title {
  font-family: var(--font-heading);
  font-size: 3.4rem;
  line-height: 1.1;
  font-weight: 900;
  letter-spacing: -1.5px;
  margin-bottom: 1.25rem;
}

.hero-title .highlight-aqua {
  color: var(--primary-cyan);
  text-shadow: var(--glow-cyan);
  position: relative;
  display: inline-block;
}

.hero-title .highlight-emerald {
  color: var(--emerald-fresh);
}

.hero-desc {
  font-size: 1.15rem;
  color: var(--text-secondary);
  margin-bottom: 2rem;
  max-width: 580px;
  line-height: 1.65;
}

.hero-stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
  margin-bottom: 2rem;
}

.stat-card {
  background: var(--bg-card);
  border: 1px solid var(--border-glass);
  border-radius: 16px;
  padding: 1.15rem 1rem;
  backdrop-filter: blur(12px);
  transition: var(--transition-smooth);
}

.stat-card:hover {
  transform: translateY(-3px);
  border-color: var(--primary-cyan);
  box-shadow: 0 8px 25px rgba(0, 210, 255, 0.15);
}

.stat-num {
  font-family: var(--font-heading);
  font-size: 1.9rem;
  font-weight: 800;
  color: var(--primary-cyan);
  line-height: 1.1;
  margin-bottom: 0.25rem;
}

.stat-label {
  font-size: 0.78rem;
  color: var(--text-secondary);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.6rem;
  padding: 0.85rem 1.6rem;
  border-radius: 12px;
  font-weight: 700;
  font-size: 0.95rem;
  cursor: pointer;
  text-decoration: none;
  transition: var(--transition-smooth);
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary-cyan), var(--primary-blue));
  color: #030b15;
  box-shadow: 0 4px 20px rgba(0, 210, 255, 0.35);
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 28px rgba(0, 210, 255, 0.55);
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.05);
  color: var(--text-primary);
  border: 1px solid var(--border-glass);
  backdrop-filter: blur(8px);
}

.btn-secondary:hover {
  background: rgba(0, 210, 255, 0.12);
  border-color: var(--primary-cyan);
  color: var(--primary-cyan);
}

.hero-image-card {
  position: relative;
  border-radius: 24px;
  overflow: hidden;
  border: 1px solid var(--border-glass);
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
}

.hero-image-card img {
  width: 100%;
  height: 440px;
  object-fit: cover;
  display: block;
  transition: transform 0.6s ease;
}

.hero-image-card:hover img {
  transform: scale(1.03);
}

.hero-image-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(3, 11, 21, 0.9) 0%, rgba(3, 11, 21, 0.25) 50%, transparent 100%);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 1.75rem;
}

.overlay-badge {
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--primary-cyan);
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 0.25rem;
}

.overlay-caption {
  font-size: 1.15rem;
  font-weight: 700;
  color: #ffffff;
}

/* ==========================================================================
   SECCIONES GENERALES
   ========================================================================== */
.section {
  position: relative;
  z-index: 10;
  max-width: 1280px;
  margin: 0 auto 5rem;
  padding: 0 1.5rem;
}

.section-header {
  text-align: center;
  margin-bottom: 3rem;
  max-width: 720px;
  margin-left: auto;
  margin-right: auto;
}

.section-tag {
  font-size: 0.85rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: var(--primary-cyan);
  margin-bottom: 0.5rem;
  display: block;
}

.section-title {
  font-family: var(--font-heading);
  font-size: 2.4rem;
  font-weight: 800;
  letter-spacing: -1px;
  margin-bottom: 0.75rem;
}

.section-desc {
  font-size: 1.05rem;
  color: var(--text-secondary);
}

/* ==========================================================================
   CALCULADORA DE HUELLA HÍDRICA
   ========================================================================== */
.calc-card {
  background: var(--bg-card);
  border: 1px solid var(--border-glass);
  border-radius: 24px;
  padding: 2.5rem;
  backdrop-filter: blur(16px);
  display: grid;
  grid-template-columns: 1.3fr 0.9fr;
  gap: 3rem;
}

.calc-sliders {
  display: flex;
  flex-direction: column;
  gap: 1.75rem;
}

.slider-group {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.slider-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.slider-label {
  font-weight: 600;
  font-size: 0.95rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.slider-val-badge {
  background: rgba(0, 210, 255, 0.12);
  color: var(--primary-cyan);
  padding: 0.2rem 0.6rem;
  border-radius: 8px;
  font-weight: 700;
  font-size: 0.88rem;
  border: 1px solid rgba(0, 210, 255, 0.25);
}

/* Custom Range Input */
input[type="range"] {
  -webkit-appearance: none;
  width: 100%;
  height: 8px;
  border-radius: 5px;
  background: rgba(255, 255, 255, 0.12);
  outline: none;
  transition: var(--transition-smooth);
}

input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: var(--primary-cyan);
  cursor: pointer;
  box-shadow: 0 0 12px var(--primary-cyan);
  transition: transform 0.15s ease;
}

input[type="range"]::-webkit-slider-thumb:hover {
  transform: scale(1.2);
}

/* Panel de Resultados de Huella */
.footprint-result-box {
  background: linear-gradient(145deg, rgba(7, 22, 38, 0.95), rgba(11, 33, 56, 0.95));
  border: 1px solid var(--border-glass);
  border-radius: 20px;
  padding: 2.25rem 2rem;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  text-align: center;
  box-shadow: inset 0 0 25px rgba(0, 210, 255, 0.05);
}

.footprint-title {
  font-size: 0.85rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1.2px;
  color: var(--primary-cyan);
}

.footprint-main-metric {
  margin: 1.5rem 0;
}

.metric-number {
  font-family: var(--font-heading);
  font-size: 4.2rem;
  font-weight: 900;
  color: var(--primary-cyan);
  line-height: 1;
  text-shadow: 0 0 30px rgba(0, 210, 255, 0.35);
}

.metric-unit {
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--text-secondary);
  text-transform: uppercase;
}

.progress-container {
  background: rgba(255, 255, 255, 0.08);
  height: 12px;
  border-radius: 10px;
  overflow: hidden;
  margin-bottom: 0.75rem;
}

.progress-bar-fill {
  height: 100%;
  width: 50%;
  background: linear-gradient(90deg, var(--emerald-fresh), var(--primary-cyan));
  transition: width 0.4s ease, background 0.4s ease;
}

.target-reference {
  display: flex;
  justify-content: space-between;
  font-size: 0.75rem;
  color: var(--text-muted);
  margin-bottom: 1.5rem;
}

.footprint-verdict {
  background: rgba(255, 255, 255, 0.04);
  border-left: 3px solid var(--primary-cyan);
  border-radius: 10px;
  padding: 1rem;
  font-size: 0.88rem;
  color: var(--text-primary);
  text-align: left;
}

/* ==========================================================================
   SIMULADOR DEL GRIFO QUE GOTEA (FUGAS)
   ========================================================================== */
.tap-sim-card {
  background: var(--bg-card);
  border: 1px solid var(--border-glass);
  border-radius: 24px;
  padding: 2.5rem;
  backdrop-filter: blur(16px);
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: 3rem;
  align-items: center;
}

.tap-visual-stage {
  background: radial-gradient(circle at 50% 30%, rgba(0, 210, 255, 0.15) 0%, rgba(3, 11, 21, 0.6) 70%);
  border: 1px solid var(--border-glass);
  border-radius: 20px;
  height: 320px;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 2rem 1rem;
}

.tap-spout {
  font-size: 4rem;
  line-height: 1;
  filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.5));
}

.water-drop {
  width: 14px;
  height: 20px;
  background: linear-gradient(to bottom, #a5f3fc, #00d2ff);
  border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
  box-shadow: 0 0 12px rgba(0, 210, 255, 0.8);
  position: absolute;
  top: 90px;
  left: 50%;
  transform: translateX(-50%);
  animation: dropFall 1.5s infinite ease-in;
}

@keyframes dropFall {
  0% {
    top: 90px;
    opacity: 0;
    transform: translateX(-50%) scale(0.6);
  }
  30% {
    opacity: 1;
    transform: translateX(-50%) scale(1);
  }
  90% {
    top: 240px;
    opacity: 1;
    transform: translateX(-50%) scale(1);
  }
  100% {
    top: 250px;
    opacity: 0;
    transform: translateX(-50%) scale(1.4);
  }
}

.tap-basin {
  width: 160px;
  height: 40px;
  border: 2px solid var(--border-glass);
  border-top: none;
  border-radius: 0 0 80px 80px;
  background: rgba(0, 210, 255, 0.08);
  position: relative;
}

.ripple-circle {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 20px;
  height: 6px;
  border: 2px solid var(--primary-cyan);
  border-radius: 50%;
  opacity: 0;
  animation: rippleExpand 1.5s infinite ease-out;
}

@keyframes rippleExpand {
  0%, 85% {
    width: 10px;
    height: 4px;
    opacity: 0;
  }
  90% {
    opacity: 1;
  }
  100% {
    width: 90px;
    height: 20px;
    opacity: 0;
  }
}

.tap-controls-box h3 {
  font-family: var(--font-heading);
  font-size: 1.6rem;
  margin-bottom: 0.5rem;
}

.tap-controls-box p {
  color: var(--text-secondary);
  font-size: 0.95rem;
  margin-bottom: 1.5rem;
}

.leak-metrics-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem;
  margin-bottom: 1.5rem;
}

.leak-stat-box {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--border-glass);
  border-radius: 12px;
  padding: 1rem;
  text-align: center;
}

.leak-stat-val {
  font-family: var(--font-heading);
  font-size: 1.8rem;
  font-weight: 800;
  color: var(--danger-coral);
}

.leak-stat-lbl {
  font-size: 0.75rem;
  color: var(--text-secondary);
  text-transform: uppercase;
}

.btn-fix-tap {
  background: linear-gradient(135deg, var(--emerald-fresh), #059669);
  color: #ffffff;
  box-shadow: 0 4px 18px var(--emerald-glow);
  width: 100%;
}

.btn-fix-tap:hover {
  box-shadow: 0 6px 25px var(--emerald-glow);
  transform: translateY(-2px);
}

/* ==========================================================================
   HUELLA HÍDRICA OCULTA (AGUA VIRTUAL EN PRODUCTOS)
   ========================================================================== */
.virtual-water-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.25rem;
}

.virtual-card {
  background: var(--bg-card);
  border: 1px solid var(--border-glass);
  border-radius: 18px;
  padding: 1.75rem;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition: var(--transition-smooth);
}

.virtual-card:hover {
  transform: translateY(-4px);
  border-color: var(--primary-cyan);
  box-shadow: var(--card-shadow);
}

.virtual-icon {
  font-size: 2.2rem;
  margin-bottom: 0.75rem;
  display: inline-block;
}

.virtual-title {
  font-family: var(--font-heading);
  font-size: 1.25rem;
  font-weight: 700;
  margin-bottom: 0.4rem;
}

.virtual-liters {
  font-family: var(--font-heading);
  font-size: 1.8rem;
  font-weight: 900;
  color: var(--primary-cyan);
  display: flex;
  align-items: baseline;
  gap: 0.3rem;
  margin-bottom: 0.75rem;
}

.virtual-liters span {
  font-size: 0.85rem;
  color: var(--text-muted);
  font-weight: 600;
}

.virtual-desc {
  font-size: 0.88rem;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* ==========================================================================
   GUÍA PRÁCTICA & COSECHA DE LLUVIA
   ========================================================================== */
.guide-tabs {
  display: flex;
  justify-content: center;
  gap: 0.75rem;
  margin-bottom: 2rem;
  flex-wrap: wrap;
}

.guide-tab-btn {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--border-glass);
  color: var(--text-secondary);
  padding: 0.65rem 1.4rem;
  border-radius: 12px;
  font-weight: 700;
  font-size: 0.9rem;
  cursor: pointer;
  transition: var(--transition-smooth);
}

.guide-tab-btn.active,
.guide-tab-btn:hover {
  background: rgba(0, 210, 255, 0.15);
  border-color: var(--primary-cyan);
  color: var(--primary-cyan);
}

.guide-tab-content {
  display: none;
}

.guide-tab-content.active {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  align-items: center;
}

.guide-card-list {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.guide-item {
  background: var(--bg-card);
  border: 1px solid var(--border-glass);
  border-radius: 14px;
  padding: 1.25rem;
  display: flex;
  align-items: flex-start;
  gap: 1rem;
  transition: var(--transition-smooth);
}

.guide-item:hover {
  border-color: var(--emerald-fresh);
  transform: translateX(4px);
}

.guide-item-icon {
  font-size: 1.6rem;
  background: rgba(16, 185, 129, 0.15);
  width: 44px;
  height: 44px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.guide-item h4 {
  font-size: 1.05rem;
  margin-bottom: 0.25rem;
}

.guide-item p {
  font-size: 0.85rem;
  color: var(--text-secondary);
}

.savings-chip {
  display: inline-block;
  margin-top: 0.4rem;
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--emerald-fresh);
  background: rgba(16, 185, 129, 0.1);
  padding: 0.2rem 0.5rem;
  border-radius: 6px;
}

.guide-visual img {
  width: 100%;
  height: 380px;
  object-fit: cover;
  border-radius: 20px;
  border: 1px solid var(--border-glass);
}

/* ==========================================================================
   TRIVIA INTERACTIVA: ¿CUÁNTO SABES?
   ========================================================================== */
.trivia-card {
  background: var(--bg-card);
  border: 1px solid var(--border-glass);
  border-radius: 24px;
  padding: 2.5rem;
  backdrop-filter: blur(16px);
  max-width: 800px;
  margin: 0 auto;
}

.trivia-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
  border-bottom: 1px solid var(--border-glass);
  padding-bottom: 1rem;
}

.question-text {
  font-family: var(--font-heading);
  font-size: 1.35rem;
  font-weight: 700;
  margin-bottom: 1.5rem;
}

.options-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0.85rem;
  margin-bottom: 1.5rem;
}

.option-btn {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--border-glass);
  color: var(--text-primary);
  padding: 1rem 1.25rem;
  border-radius: 12px;
  text-align: left;
  font-size: 0.95rem;
  cursor: pointer;
  transition: var(--transition-smooth);
}

.option-btn:hover {
  background: rgba(0, 210, 255, 0.1);
  border-color: var(--primary-cyan);
}

.option-btn.correct {
  background: rgba(16, 185, 129, 0.2);
  border-color: var(--emerald-fresh);
  color: #34d399;
}

.option-btn.incorrect {
  background: rgba(244, 63, 94, 0.2);
  border-color: var(--danger-coral);
  color: #fda4af;
}

.quiz-feedback {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 10px;
  padding: 1rem;
  font-size: 0.9rem;
  display: none;
  margin-bottom: 1.25rem;
}

/* ==========================================================================
   PACTO CIUDADANO POR EL AGUA (COMPROMISO)
   ========================================================================== */
.pledge-card {
  background: linear-gradient(135deg, rgba(7, 22, 38, 0.95), rgba(16, 42, 71, 0.9));
  border: 1px solid var(--border-glass);
  border-radius: 24px;
  padding: 3rem;
  max-width: 860px;
  margin: 0 auto;
  text-align: center;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
}

.pledge-checklist {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem;
  text-align: left;
  margin: 2rem 0;
}

.pledge-item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  background: rgba(0, 0, 0, 0.25);
  border: 1px solid var(--border-glass);
  padding: 0.85rem 1rem;
  border-radius: 12px;
  font-size: 0.88rem;
  cursor: pointer;
}

.pledge-item input {
  accent-color: var(--emerald-fresh);
  width: 18px;
  height: 18px;
}

.signature-box {
  display: flex;
  gap: 1rem;
  max-width: 520px;
  margin: 0 auto;
}

.signature-input {
  flex: 1;
  padding: 0.85rem 1.2rem;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid var(--border-glass);
  color: var(--text-primary);
  font-size: 0.95rem;
  outline: none;
}

.signature-input:focus {
  border-color: var(--primary-cyan);
  box-shadow: 0 0 12px rgba(0, 210, 255, 0.3);
}

/* Certificado Dinámico Generado */
.certificate-output {
  display: none;
  background: radial-gradient(circle at 50% 50%, rgba(0, 210, 255, 0.15) 0%, rgba(3, 11, 21, 0.9) 80%);
  border: 2px solid var(--primary-cyan);
  border-radius: 18px;
  padding: 2rem;
  margin-top: 2rem;
  box-shadow: 0 0 30px rgba(0, 210, 255, 0.25);
  animation: fadeIn 0.5s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

.cert-title {
  font-family: var(--font-heading);
  font-size: 1.6rem;
  color: var(--primary-cyan);
  margin-bottom: 0.5rem;
}

.cert-name {
  font-size: 1.8rem;
  font-weight: 900;
  color: #ffffff;
  text-decoration: underline;
  text-decoration-color: var(--emerald-fresh);
  margin: 0.5rem 0;
}

/* ==========================================================================
   FOOTER
   ========================================================================== */
.site-footer {
  position: relative;
  z-index: 10;
  border-top: 1px solid var(--border-glass);
  background: rgba(3, 11, 21, 0.95);
  padding: 3rem 1.5rem;
  text-align: center;
}

.footer-quote {
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--primary-cyan);
  margin-bottom: 0.5rem;
}

.footer-desc {
  font-size: 0.9rem;
  color: var(--text-secondary);
  max-width: 600px;
  margin: 0 auto 1.5rem;
}

.footer-copy {
  font-size: 0.8rem;
  color: var(--text-muted);
}

/* ==========================================================================
   RESPONSIVIDAD
   ========================================================================== */
@media (max-width: 1024px) {
  .hero {
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  .hero-image-card img {
    height: 350px;
  }
  .calc-card {
    grid-template-columns: 1fr;
  }
  .tap-sim-card {
    grid-template-columns: 1fr;
  }
  .guide-tab-content.active {
    grid-template-columns: 1fr;
  }
  .guide-visual img {
    height: 280px;
  }
}

@media (max-width: 768px) {
  .hero-title {
    font-size: 2.3rem;
  }
  .hero-stats-grid {
    grid-template-columns: 1fr;
  }
  .main-nav {
    display: none;
  }
  .pledge-checklist {
    grid-template-columns: 1fr;
  }
  .signature-box {
    flex-direction: column;
  }
}
