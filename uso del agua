/**
 * ============================================================================
 * USO DEL AGUA - SCRIPT INTERACTIVO
 * Web Audio sintetizado, calculadora de huella hídrica, simulador de fuga,
 * trivia educativa y generador de certificado de compromiso.
 * ============================================================================
 */

document.addEventListener('DOMContentLoaded', () => {
  // --------------------------------------------------------------------------
  // 1. SISTEMA DE AUDIO SINTETIZADO (Web Audio API)
  // Sin archivos externos: sintetiza gotas de agua, sonido ambiental y fanfarria.
  // --------------------------------------------------------------------------
  let audioCtx = null;
  let ambientSource = null;
  let ambientGain = null;
  let isAmbientPlaying = false;

  function initAudio() {
    if (!audioCtx) {
      const AudioContext = window.AudioContext || window.webkitAudioContext;
      if (AudioContext) {
        audioCtx = new AudioContext();
      }
    }
    if (audioCtx && audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
  }

  // Sonido de gota de agua sintetizado ("bloop")
  function playWaterDropSound() {
    initAudio();
    if (!audioCtx) return;

    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();

    osc.type = 'sine';
    const now = audioCtx.currentTime;

    // Frecuencia que cae rápidamente para el clásico "plop" acuático
    osc.frequency.setValueAtTime(800, now);
    osc.frequency.exponentialRampToValueAtTime(320, now + 0.12);

    gain.gain.setValueAtTime(0.35, now);
    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.12);

    osc.connect(gain);
    gain.connect(audioCtx.destination);

    osc.start(now);
    osc.stop(now + 0.12);
  }

  // Sonido de fanfarria / logro
  function playSuccessChime() {
    initAudio();
    if (!audioCtx) return;

    const notes = [329.63, 392.00, 523.25, 659.25]; // E4, G4, C5, E5
    notes.forEach((freq, idx) => {
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      const startTime = audioCtx.currentTime + idx * 0.08;

      osc.type = 'triangle';
      osc.frequency.setValueAtTime(freq, startTime);

      gain.gain.setValueAtTime(0.2, startTime);
      gain.gain.exponentialRampToValueAtTime(0.001, startTime + 0.35);

      osc.connect(gain);
      gain.connect(audioCtx.destination);

      osc.start(startTime);
      osc.stop(startTime + 0.35);
    });
  }

  // Sonido relajante continuo de arroyo/agua corriente
  function toggleAmbientSound() {
    initAudio();
    if (!audioCtx) return;

    const btn = document.getElementById('ambientAudioBtn');

    if (isAmbientPlaying) {
      if (ambientGain) {
        ambientGain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.5);
        setTimeout(() => {
          if (ambientSource) ambientSource.stop();
          isAmbientPlaying = false;
          if (btn) {
            btn.classList.remove('playing');
            btn.innerHTML = '<span>🔊</span> Sonido Relajante';
          }
        }, 500);
      }
    } else {
      // Crear ruido blanco filtrado como agua corriente suave
      const bufferSize = audioCtx.sampleRate * 2;
      const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
      const data = buffer.getChannelData(0);
      for (let i = 0; i < bufferSize; i++) {
        data[i] = (Math.random() * 2 - 1) * 0.15;
      }

      ambientSource = audioCtx.createBufferSource();
      ambientSource.buffer = buffer;
      ambientSource.loop = true;

      const filter = audioCtx.createBiquadFilter();
      filter.type = 'lowpass';
      filter.frequency.setValueAtTime(650, audioCtx.currentTime);

      ambientGain = audioCtx.createGain();
      ambientGain.gain.setValueAtTime(0.001, audioCtx.currentTime);
      ambientGain.gain.exponentialRampToValueAtTime(0.18, audioCtx.currentTime + 0.5);

      ambientSource.connect(filter);
      filter.connect(ambientGain);
      ambientGain.connect(audioCtx.destination);

      ambientSource.start();
      isAmbientPlaying = true;

      if (btn) {
        btn.classList.add('playing');
        btn.innerHTML = '<span>💧</span> Sonido Activo';
      }
    }
  }

  const ambientBtn = document.getElementById('ambientAudioBtn');
  if (ambientBtn) {
    ambientBtn.addEventListener('click', toggleAmbientSound);
  }

  // --------------------------------------------------------------------------
  // 2. CALCULADORA DE HUELLA HÍDRICA DIARIA
  // --------------------------------------------------------------------------
  const showerRange = document.getElementById('showerRange');
  const teethRange = document.getElementById('teethRange');
  const dishesRange = document.getElementById('dishesRange');
  const laundryRange = document.getElementById('laundryRange');
  const gardenRange = document.getElementById('gardenRange');

  const showerVal = document.getElementById('showerVal');
  const teethVal = document.getElementById('teethVal');
  const dishesVal = document.getElementById('dishesVal');
  const laundryVal = document.getElementById('laundryVal');
  const gardenVal = document.getElementById('gardenVal');

  const footprintLitersEl = document.getElementById('footprintLiters');
  const footprintProgressFill = document.getElementById('footprintProgressFill');
  const footprintVerdictEl = document.getElementById('footprintVerdict');

  function updateFootprint() {
    const showerMin = parseInt(showerRange.value, 10);
    const teethMin = parseInt(teethRange.value, 10);
    const dishesMin = parseInt(dishesRange.value, 10);
    const laundryPerWeek = parseInt(laundryRange.value, 10);
    const gardenMin = parseInt(gardenRange.value, 10);

    // Actualizar etiquetas visuales
    showerVal.textContent = `${showerMin} min`;
    teethVal.textContent = `${teethMin} min`;
    dishesVal.textContent = `${dishesMin} min`;
    laundryVal.textContent = `${laundryPerWeek} por sem.`;
    gardenVal.textContent = `${gardenMin} min`;

    // Tasas estándar de consumo (L/min):
    // Ducha: ~12 L/min
    // Grifo abierto para dientes/lavabo: ~6 L/min
    // Lavado de platos con chorro abierto: ~9 L/min
    // Lavadora por carga (~65 L divididos entre 7 días): ~9.3 L/día por ciclo semanal
    // Manguera de jardín: ~15 L/min
    const dailyShower = showerMin * 12;
    const dailyTeeth = teethMin * 6;
    const dailyDishes = dishesMin * 9;
    const dailyLaundry = (laundryPerWeek * 65) / 7;
    const dailyGarden = gardenMin * 15;

    // Consumo basal para hidratación y cocción: ~15 L
    const baseConsumption = 15;

    const totalLiters = Math.round(dailyShower + dailyTeeth + dailyDishes + dailyLaundry + dailyGarden + baseConsumption);

    if (footprintLitersEl) {
      footprintLitersEl.textContent = totalLiters;
    }

    // Porcentaje visual basado en 350 Litros máx.
    const percentage = Math.min(Math.max((totalLiters / 350) * 100, 8), 100);
    if (footprintProgressFill) {
      footprintProgressFill.style.width = `${percentage}%`;

      if (totalLiters <= 120) {
        footprintProgressFill.style.background = 'linear-gradient(90deg, #10b981, #34d399)';
        footprintVerdictEl.innerHTML = `
          <strong>🌿 ¡Excelente consumo responsable!</strong><br>
          Estás dentro del rango recomendado por la OMS (~100L diarios). Tus hábitos cuidan activamente las reservas de agua para el futuro.
        `;
      } else if (totalLiters <= 220) {
        footprintProgressFill.style.background = 'linear-gradient(90deg, #f59e0b, #fbbf24)';
        footprintVerdictEl.innerHTML = `
          <strong>💧 Consumo Moderado con Oportunidad de Ahorro:</strong><br>
          Consumes ${totalLiters} L/día. Si reduces tu ducha a 5 minutos y cierras la llave al cepillarte, puedes ahorrar hasta <strong>${Math.round(totalLiters * 0.35)} litros diarios</strong>.
        `;
      } else {
        footprintProgressFill.style.background = 'linear-gradient(90deg, #f43f5e, #fb7185)';
        footprintVerdictEl.innerHTML = `
          <strong>⚠️ Alerta de Alto Consumo (${totalLiters} L/día):</strong><br>
          Estás consumiendo más del doble de lo necesario. El uso de manguera continua y duchas prolongadas son los mayores puntos de fuga. ¡Cambiando a balde o tobo ahorrarías más del 50%!
        `;
      }
    }
  }

  [showerRange, teethRange, dishesRange, laundryRange, gardenRange].forEach((slider) => {
    if (slider) {
      slider.addEventListener('input', () => {
        updateFootprint();
      });
    }
  });

  updateFootprint();

  // --------------------------------------------------------------------------
  // 3. SIMULADOR DEL GRIFO QUE GOTEA
  // --------------------------------------------------------------------------
  const dripRateSelect = document.getElementById('dripRateSelect');
  const leakPerHourEl = document.getElementById('leakPerHour');
  const leakPerMonthEl = document.getElementById('leakPerMonth');
  const waterDropAnim = document.getElementById('waterDropAnim');
  const btnFixTap = document.getElementById('btnFixTap');
  const tapStatusText = document.getElementById('tapStatusText');
  let isLeakFixed = false;

  const dripRates = {
    slow: { lPerHour: 0.8, lPerMonth: 580, animDuration: '2.5s' },
    medium: { lPerHour: 1.8, lPerMonth: 1300, animDuration: '1.4s' },
    fast: { lPerHour: 4.2, lPerMonth: 3020, animDuration: '0.7s' },
    stream: { lPerHour: 12.0, lPerMonth: 8640, animDuration: '0.3s' }
  };

  function updateLeak() {
    if (isLeakFixed) return;
    const rate = dripRates[dripRateSelect.value] || dripRates.medium;
    leakPerHourEl.textContent = `${rate.lPerHour.toFixed(1)} L`;
    leakPerMonthEl.textContent = `${rate.lPerMonth.toLocaleString()} L`;

    if (waterDropAnim) {
      waterDropAnim.style.animationDuration = rate.animDuration;
      waterDropAnim.style.display = 'block';
    }
  }

  if (dripRateSelect) {
    dripRateSelect.addEventListener('change', () => {
      isLeakFixed = false;
      if (tapStatusText) tapStatusText.textContent = 'Goteo activo en curso...';
      updateLeak();
    });
  }

  if (btnFixTap) {
    btnFixTap.addEventListener('click', () => {
      isLeakFixed = true;
      if (waterDropAnim) {
        waterDropAnim.style.display = 'none';
      }
      leakPerHourEl.textContent = '0.0 L';
      leakPerMonthEl.textContent = '0 L';
      if (tapStatusText) {
        tapStatusText.innerHTML = '✨ <strong>¡Grifo ajustado y sellado!</strong> Cero desperdicio.';
      }
      playWaterDropSound();
      playSuccessChime();
    });
  }

  updateLeak();

  // --------------------------------------------------------------------------
  // 4. PESTAÑAS DE GUÍA PRÁCTICA
  // --------------------------------------------------------------------------
  const tabBtns = document.querySelectorAll('.guide-tab-btn');
  const tabPanels = document.querySelectorAll('.guide-tab-content');

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.tab;
      tabBtns.forEach((b) => b.classList.remove('active'));
      tabPanels.forEach((p) => p.classList.remove('active'));

      btn.classList.add('active');
      const activePanel = document.getElementById(`tab-${target}`);
      if (activePanel) {
        activePanel.classList.add('active');
      }
      playWaterDropSound();
    });
  });

  // --------------------------------------------------------------------------
  // 5. TRIVIA INTERACTIVA: ¿CUÁNTO SABES DEL AGUA?
  // --------------------------------------------------------------------------
  const quizData = [
    {
      question: '¿Qué porcentaje del agua total del planeta es agua dulce accesible para consumo humano?',
      options: ['Aproximadamente el 20%', 'Menos del 1%', 'Casi el 10%', 'El 50%'],
      correct: 1,
      explanation: 'Aunque el 71% del planeta es agua, el 97.5% es salada. Del 2.5% de agua dulce restante, la inmensa mayoría está congelada en glaciares o bajo tierra profunda, dejando menos del 1% accesible en ríos y lagos.'
    },
    {
      question: '¿Cuántos litros de agua virtual se necesitan para fabricar una sola camiseta de algodón?',
      options: ['Unos 100 litros', 'Alrededor de 2.700 litros', '500 litros', '50 litros'],
      correct: 1,
      explanation: 'El cultivo y procesamiento del algodón es altamente intensivo en agua: fabricar una camiseta requiere aproximadamente 2.700 litros, lo que bebe una persona en casi 3 años.'
    },
    {
      question: '¿Cuál es el tiempo máximo de ducha recomendado por la OMS para un uso sostenible?',
      options: ['5 minutos', '15 minutos', '25 minutos', 'No hay límite'],
      correct: 0,
      explanation: 'La OMS recomienda duchas de máximo 5 minutos, lo que gasta unos 60 litros en lugar de los 150 a 200 litros de un baño prolongado.'
    },
    {
      question: '¿Qué hábito genera el mayor ahorro de agua potable en la limpieza exterior?',
      options: ['Usar manguera a presión continua', 'Barrer en seco y usar un tobo/balde de agua', 'Limpiar todos los días con agua corriente', 'Dejar correr el agua por la pendiente'],
      correct: 1,
      explanation: 'Barrer primero la suciedad en seco y usar un balde en vez de manguera ahorra hasta un 85% de agua en patios, aceras y lavado de vehículos.'
    }
  ];

  let currentQuestionIndex = 0;
  let quizScore = 0;

  const quizQuestionText = document.getElementById('quizQuestionText');
  const quizOptionsGrid = document.getElementById('quizOptionsGrid');
  const quizFeedback = document.getElementById('quizFeedback');
  const quizScoreEl = document.getElementById('quizScoreEl');
  const quizNextBtn = document.getElementById('quizNextBtn');

  function renderQuestion() {
    const q = quizData[currentQuestionIndex];
    if (!q) return;

    if (quizQuestionText) quizQuestionText.textContent = `${currentQuestionIndex + 1}. ${q.question}`;
    if (quizFeedback) {
      quizFeedback.style.display = 'none';
      quizFeedback.textContent = '';
    }
    if (quizNextBtn) quizNextBtn.style.display = 'none';

    if (quizOptionsGrid) {
      quizOptionsGrid.innerHTML = '';
      q.options.forEach((opt, idx) => {
        const btn = document.createElement('button');
        btn.className = 'option-btn';
        btn.textContent = opt;
        btn.addEventListener('click', () => handleOptionSelect(idx, btn));
        quizOptionsGrid.appendChild(btn);
      });
    }

    if (quizScoreEl) {
      quizScoreEl.textContent = `Puntaje: ${quizScore} / ${quizData.length}`;
    }
  }

  function handleOptionSelect(selectedIndex, clickedBtn) {
    const q = quizData[currentQuestionIndex];
    const allBtns = quizOptionsGrid.querySelectorAll('.option-btn');
    allBtns.forEach((b) => (b.disabled = true));

    if (selectedIndex === q.correct) {
      clickedBtn.classList.add('correct');
      quizScore++;
      playSuccessChime();
      quizFeedback.innerHTML = `<strong>¡Correcto! 🎉</strong> ${q.explanation}`;
    } else {
      clickedBtn.classList.add('incorrect');
      allBtns[q.correct].classList.add('correct');
      playWaterDropSound();
      quizFeedback.innerHTML = `<strong>Respuesta incorrecta.</strong> ${q.explanation}`;
    }

    quizFeedback.style.display = 'block';
    if (quizScoreEl) quizScoreEl.textContent = `Puntaje: ${quizScore} / ${quizData.length}`;

    if (currentQuestionIndex < quizData.length - 1) {
      if (quizNextBtn) {
        quizNextBtn.style.display = 'inline-flex';
        quizNextBtn.textContent = 'Siguiente Pregunta →';
      }
    } else {
      if (quizNextBtn) {
        quizNextBtn.style.display = 'inline-flex';
        quizNextBtn.textContent = 'Ver Resultado Final 🏆';
      }
    }
  }

  if (quizNextBtn) {
    quizNextBtn.addEventListener('click', () => {
      if (currentQuestionIndex < quizData.length - 1) {
        currentQuestionIndex++;
        renderQuestion();
      } else {
        // Fin de la trivia
        if (quizQuestionText) {
          quizQuestionText.textContent = `¡Trivia Completada! Has obtenido ${quizScore} de ${quizData.length} puntos.`;
        }
        if (quizOptionsGrid) quizOptionsGrid.innerHTML = '';
        quizFeedback.style.display = 'block';
        quizFeedback.innerHTML = `
          <div style="text-align: center; padding: 1rem 0;">
            <h3>${quizScore >= 3 ? '🌊 ¡Sos un Guardián Experto del Agua!' : '🌱 ¡Buen intento! Ahora ya conoces cómo proteger este recurso vital.'}</h3>
            <p>Comparte estos datos con tu familia y amigos para que cada gota cuente.</p>
          </div>
        `;
        quizNextBtn.style.display = 'none';
        playSuccessChime();
      }
    });
  }

  renderQuestion();

  // --------------------------------------------------------------------------
  // 6. PACTO CIUDADANO POR EL AGUA (GENERADOR DE CERTIFICADO)
  // --------------------------------------------------------------------------
  const pledgeForm = document.getElementById('pledgeForm');
  const certOutput = document.getElementById('certificateOutput');
  const certHolderName = document.getElementById('certHolderName');
  const certDate = document.getElementById('certDate');

  if (pledgeForm) {
    pledgeForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const nameInput = document.getElementById('pledgeNameInput');
      const name = nameInput.value.trim();

      if (!name) return;

      const checkedItems = pledgeForm.querySelectorAll('input[type="checkbox"]:checked');
      if (checkedItems.length < 2) {
        alert('Por favor selecciona al menos dos compromisos para firmar tu pacto por el agua.');
        return;
      }

      if (certHolderName) certHolderName.textContent = name;
      if (certDate) {
        const today = new Date();
        certDate.textContent = today.toLocaleDateString('es-ES', {
          year: 'numeric',
          month: 'long',
          day: 'numeric'
        });
      }

      if (certOutput) {
        certOutput.style.display = 'block';
        certOutput.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      playSuccessChime();
    });
  }
});




