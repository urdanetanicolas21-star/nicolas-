css

.header-fijo {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 50px;
    background: #333;
    color: white;
    padding: 15px;
    box-sizing: border-box;
    z-index: 10;
}
.footer-fijo {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 40px;
    background: #333;
    color: white;
    padding: 10px;
    box-sizing: border-box;
}
.contenido-principal {
    padding-top: 60px;
    padding-bottom: 50px;
    min-height: 100vh;
    box-sizing: border-box;
}
