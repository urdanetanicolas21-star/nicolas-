body {
    font-family: arial, sans-serif;
    margin: 0;
    padding: 0;
    background-color: #f4f6f8;
    color: #333;
}

header {
    background-color: #2c3e50;
    color: white;
    padding: 30px 20px;
    text-align: center;
}

main {
    padding: 0 20px;
    max-width: 700px;
    margin: 20px auto;
}

.tarjeta-seccion {
    background-color: white;
    padding: 20px;
    margin-bottom: 20px;
    border-radius: 8px;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
}

.foto-perfil {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    display: block;
    margin: 15xp auto;
    border: 3px solid #3498db;
}

h2 {
    color: #2c3e50;
    border-bottom: 2px solid #ecf0f1;
    padding-bottom: 8px;
}

.lista-hobbies {
    line-height: 1.8;
}

footer {
    background-color: #1e2b37;
    color: white;
    text-align: center;
    padding: 15px 20px;
    margin-top: 40px;
}

footer a {
    color: #3498db;
    text-decoration: none;
    margin: 0 5px;
}

footer a:hover {
    text-decoration: underline;
}
